# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Base de datos (coincide con docker-compose.yml)
POSTGRES_USER=airova
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=airova
DATABASE_URL=postgresql://airova:cambiar_esta_clave@localhost:5432/airova?schema=public

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Autenticación
# JWT_ACCESS_SECRET: mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
# El refresh token es opaco, rotativo y se guarda hasheado en la base de datos.
REFRESH_TTL_DAYS=7

# Seed (npm run db:seed --workspace @airova/api)
# Contraseña del administrador inicial (mínimo 12 caracteres). Obligatoria.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@airova.local
# true = crea además un conductor, un colaborador, buses, ruta, horario y turno de ejemplo
SEED_SAMPLE_DATA=false
