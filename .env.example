# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Base de datos (coincide con docker-compose.yml)
POSTGRES_USER=airova
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=airova
DATABASE_URL=postgresql://airova:cambiar_esta_clave@localhost:5432/airova?schema=public

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Autenticación (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
